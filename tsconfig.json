{
  "compilerOptions": {
    "paths": {
      "@src/*": ["./src/*"],
      "@pages/*": ["./pages/*"],
    },
    "target": "ES6",
    "module": "nodenext" /* Specify the root folder within your source files. */,
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ] /* Specify type package names to be included without being referenced in a source file. */,
    "typeRoots": ["./node_modules/@types"],
    "resolvePackageJsonExports": true /* Use the package.json 'exports' field when resolving package imports. */,
    "resolvePackageJsonImports": true /* Check side effect imports. */,
    "resolveJsonModule": true /* Allow 'import x from y' when a module doesn't have a default export. */,
    "esModuleInterop": true /* Disable resolving symlinks to their realpath. This correlates to the same flag in node. */,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
